# Example Vite env vars for Firebase (copy to .env.local and fill with your project values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: measurement ID
VITE_FIREBASE_MEASUREMENT_ID=

# Notes:
# - Do NOT commit your real .env.local to version control.
# - After setting these, install firebase: npm install firebase